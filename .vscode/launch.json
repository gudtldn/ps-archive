{
    // 문제 폴더의 main.cpp / main.rs를 연 상태에서 F5를 누르면 tests/N.in을 stdin으로 넣고 디버깅합니다.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++: 현재 문제 디버그",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "C++: 디버그 빌드",
            "program": "${workspaceFolder}/.build/debug/${fileDirnameBasename}.exe",
            "args": ["<", "${fileDirname}/tests/${input:testCase}.in"],
            "cwd": "${fileDirname}",
            "MIMode": "gdb",
            // 경로 없이 이름만 주면 PATH에서 찾습니다 (MinGW gdb).
            "miDebuggerPath": "gdb.exe",
            "externalConsole": false,
            "setupCommands": [
                { "description": "STL 컨테이너를 보기 좋게 표시", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "Rust: 현재 문제 디버그",
            "type": "lldb",
            "request": "launch",
            // CodeLLDB의 "cargo" 옵션은 결과물을 여러 개로 잘못 세는 경우가 있어("Multiple compilation artifacts"),
            // C++처럼 task로 빌드하고 실행 파일 경로를 직접 넘깁니다.
            "preLaunchTask": "Rust: 디버그 빌드",
            "program": "${workspaceFolder}/target/debug/p${fileDirnameBasename}.exe",
            "stdio": ["${fileDirname}/tests/${input:testCase}.in", null, null],
            "cwd": "${fileDirname}"
        }
    ],
    "inputs": [
        {
            "id": "testCase",
            "type": "promptString",
            "description": "stdin으로 넣을 테스트 번호 (tests/N.in)",
            "default": "1"
        }
    ]
}
